#!/usr/bin/env ruby
# frozen_string_literal: true

module AwsLogin
  CONFIG_PATH = File.join(Dir.home, ".aws", "config")

  def self.parse_ini(text)
    sections = {}
    current = nil
    text.each_line do |raw|
      line = raw.strip
      next if line.empty? || line.start_with?("#", ";")

      if (header = line[/\A\[(.+)\]\z/, 1])
        current = (sections[header.strip] ||= {})
      elsif current && (eq = line.index("="))
        current[line[0, eq].strip] = line[(eq + 1)..].strip
      end
    end
    sections
  end

  def self.profile_name(section)
    return "default" if section == "default"

    section.sub(/\Aprofile\s+/, "").strip if section.start_with?("profile ")
  end

  # One `aws sso login` refreshes every profile sharing an sso_session, so the unit of
  # work is the session, not the profile. Legacy profiles carrying an inline sso_start_url
  # have no session to share and each need a login of their own.
  def self.login_targets(text)
    targets = []
    by_session = {}
    parse_ini(text).each do |section, values|
      profile = profile_name(section)
      next unless profile

      if (session = values["sso_session"])
        if (target = by_session[session])
          target[:profiles] << profile
        else
          target = { label: "sso-session #{session}", profiles: [profile] }
          by_session[session] = target
          targets << target
        end
      elsif values["sso_start_url"]
        targets << { label: "profile #{profile}", profiles: [profile] }
      end
    end
    targets
  end

  def self.describe(target)
    "#{target[:label]}: #{target[:profiles].join(", ")}"
  end
end

if $PROGRAM_NAME == __FILE__
  command = ARGV.find { |arg| !arg.start_with?("-") } || "login"
  device_code = ARGV.include?("--use-device-code")

  unless %w[list login].include?(command)
    warn "Usage: awslogin [list|login] [--use-device-code]"
    exit 2
  end

  unless File.readable?(AwsLogin::CONFIG_PATH)
    warn "Cannot read #{AwsLogin::CONFIG_PATH}"
    exit 1
  end

  targets = AwsLogin.login_targets(File.read(AwsLogin::CONFIG_PATH))
  if targets.empty?
    warn "No SSO profiles found in #{AwsLogin::CONFIG_PATH}"
    exit 1
  end

  if command == "list"
    targets.each { |target| puts AwsLogin.describe(target) }
    exit 0
  end

  failed = 0
  targets.each do |target|
    puts "\n==> #{AwsLogin.describe(target)}"
    argv = ["aws", "sso", "login", "--profile", target[:profiles].first]
    # --no-browser switches the CLI to PrintOnlyHandler, which prints a
    # verificationUriComplete URL that autofills the device code. Without it,
    # OpenBrowserHandler tries to launch a browser and never prints that URL.
    argv.push("--use-device-code", "--no-browser") if device_code
    next if system(*argv)

    failed += 1
    warn "login failed: #{AwsLogin.describe(target)}"
  end
  exit(failed.zero? ? 0 : 1)
end
