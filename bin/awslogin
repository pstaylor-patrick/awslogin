#!/usr/bin/env ruby
# frozen_string_literal: true

module AwsLogin
  CONFIG_PATH = File.join(Dir.home, ".aws", "config")

  # Raised when a name on the command line does not resolve to exactly one login target.
  Error = Class.new(StandardError)

  def self.parse_ini(text)
    sections = {}
    current = nil
    text.each_line do |raw|
      line = raw.strip
      next if line.empty? || line.start_with?("#", ";")

      if (header = line[/\A\[(.+)\]\z/, 1])
        current = (sections[header.strip] ||= {})
      elsif current && (eq = line.index("="))
        current[line[0, eq].strip] = line[(eq + 1)..].strip
      end
    end
    sections
  end

  def self.profile_name(section)
    return "default" if section == "default"

    section.sub(/\Aprofile\s+/, "").strip if section.start_with?("profile ")
  end

  # One `aws sso login` refreshes every profile sharing an sso_session, so the unit of
  # work is the session, not the profile. Legacy profiles carrying an inline sso_start_url
  # have no session to share and each need a login of their own.
  def self.login_targets(text)
    targets = []
    by_session = {}
    parse_ini(text).each do |section, values|
      profile = profile_name(section)
      next unless profile

      if (session = values["sso_session"])
        if (target = by_session[session])
          target[:profiles] << profile
        else
          target = { name: session, label: "sso-session #{session}", profiles: [profile] }
          by_session[session] = target
          targets << target
        end
      elsif values["sso_start_url"]
        targets << { name: profile, label: "profile #{profile}", profiles: [profile] }
      end
    end
    targets
  end

  def self.describe(target)
    "#{target[:label]}: #{target[:profiles].join(", ")}"
  end

  # Everything a name on the command line may match: the target's own sso-session (or
  # legacy profile) name, plus every profile it covers.
  def self.terms(target)
    [target[:name], *target[:profiles]].map(&:downcase)
  end

  # Naming one profile names its whole target, because a single `aws sso login` refreshes
  # them all. An exact name wins outright, so `j2j` is the profile `j2j` even though it is
  # also a substring of `j2j-dns`. Otherwise the name is treated as a substring and has to
  # land on a single target: `prod` spans unrelated accounts, and guessing which one was
  # meant is worse than asking for more letters.
  def self.resolve(targets, name)
    query = name.downcase
    exact = targets.select { |target| terms(target).include?(query) }
    return exact unless exact.empty?

    matched = targets.select { |target| terms(target).any? { |term| term.include?(query) } }
    raise Error, "No login target matches #{name.inspect}. Run `awslogin list` to see them all." if matched.empty?
    raise Error, ambiguous_message(name, matched) if matched.size > 1

    matched
  end

  def self.ambiguous_message(name, matched)
    ["#{name.inspect} matches #{matched.size} login targets:",
     *matched.map { |target| "  #{describe(target)}" },
     "Use more of the name, or an exact profile or sso-session name."].join("\n")
  end

  # Every name is resolved and validated on its own before any of them are combined, so one
  # bad name fails the whole run instead of logging into half of it. Filtering the original
  # list gives config order and dedup in one step.
  def self.select_targets(targets, names)
    matched = names.flat_map { |name| resolve(targets, name) }
    targets.select { |target| matched.include?(target) }
  end
end

if $PROGRAM_NAME == __FILE__
  flags, words = ARGV.partition { |arg| arg.start_with?("-") }
  command = %w[list login].include?(words.first) ? words.shift : "login"
  device_code = flags.delete("--use-device-code")

  unless flags.empty?
    warn "Usage: awslogin [list|login] [name ...] [--use-device-code]"
    exit 2
  end

  unless File.readable?(AwsLogin::CONFIG_PATH)
    warn "Cannot read #{AwsLogin::CONFIG_PATH}"
    exit 1
  end

  targets = AwsLogin.login_targets(File.read(AwsLogin::CONFIG_PATH))
  if targets.empty?
    warn "No SSO profiles found in #{AwsLogin::CONFIG_PATH}"
    exit 1
  end

  unless words.empty?
    begin
      targets = AwsLogin.select_targets(targets, words)
    rescue AwsLogin::Error => e
      warn e.message
      exit 2
    end
  end

  if command == "list"
    targets.each { |target| puts AwsLogin.describe(target) }
    exit 0
  end

  failed = 0
  targets.each do |target|
    puts "\n==> #{AwsLogin.describe(target)}"
    argv = ["aws", "sso", "login", "--profile", target[:profiles].first]
    # --no-browser makes the CLI print a URL that autofills the device code.
    # Without it, the CLI tries to launch a browser and never prints that URL.
    argv.push("--use-device-code", "--no-browser") if device_code
    next if system(*argv)

    failed += 1
    warn "login failed: #{AwsLogin.describe(target)}"
  end
  exit(failed.zero? ? 0 : 1)
end
